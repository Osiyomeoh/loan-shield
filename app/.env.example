# Copy to app/.env (gitignored) and fill in. Never commit .env.

# Optional: defaults to https://rpc.mainnet.arc.io
ARC_RPC_URL=

# The deployed LoanShield (see the README for the mainnet address)
SHIELD_ADDRESS=

# Your borrowing wallet's key: used by buy-cirbtc, open-loan, protect and register-webhook to sign.
# Use a fresh wallet holding only what this demo needs.
PRIVATE_KEY=

# Keeper: a separate gas-only wallet (a few cents of USDC). It can only call rescue, which repays loans from
# their owners' own buffers. Leave empty and the keeper and webhook only report.
KEEPER_PRIVATE_KEY=

# Loans the keeper checks on every pass and the webhook on every alert: borrower:marketId, comma-separated
WATCH=
POLL_SECONDS=30

# Webhook: markets in which the wallet a Borrow Kit alert names is also checked, comma-separated market ids.
# Empty means the cirBTC market; "none" checks only WATCH.
ALERT_MARKETS=

# Sweep: a JSON file that remembers the policies found and the last block read, so the next pass reads only new blocks
SWEEP_STATE=
